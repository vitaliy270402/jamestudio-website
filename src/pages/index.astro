---
import BaseLayout from "../layouts/BaseLayout.astro";
import Photo from "../components/Photo.astro";
import SocialLinks from "../components/SocialLinks.astro";
import {
  categoryLabel,
  crewPhotos,
  highlightPhotos,
  photos,
  storySteps,
} from "../data/gallery";
import { faqs, reviews, serviceGroups, services, site } from "../config/site";

const heroPhoto = photos.find((photo) => photo.file === "travertine-estate-pool-patio-pavers-after.jpg");
if (!heroPhoto) {
  throw new Error("Home hero image is missing.");
}
const highlights = highlightPhotos();
const crew = crewPhotos();
const comparisons = [
  {
    id: "siding",
    title: "Siding, from wrap to finished porch",
    text: "The same ranch house: house wrap, then the finished porch and siding.",
    steps: storySteps("siding"),
  },
  {
    id: "garage",
    title: "Garage doors, painted",
    text: "Gray garage doors on a brick and stone house, in progress and finished.",
    steps: storySteps("garage"),
  },
  {
    id: "planter",
    title: "Planter and walkway",
    text: "A drainage and planter sequence, from the open trench to the finished walk.",
    steps: storySteps("planter"),
  },
];
const title = `Jamestudio Construction | Remodels in ${site.titlePlace}`;
const description = `${site.legalName} remodels and renovates homes in ${site.serviceAreaLabel}. A small crew, insured, with a warranty. Call ${site.phoneDisplay}.`;
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="hero-media">
      <Photo
        src={heroPhoto.src}
        alt={heroPhoto.alt}
        sizes="100vw"
        widths={[720, 1200, 1600]}
        priority={true}
      />
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="wrap hero-copy">
      <p class="eyebrow">DeSoto, Cedar Hill, Lancaster</p>
      <h1>{site.tagline}</h1>
      <p class="lede">
        {site.legalName} remodels and renovates homes for people in {site.serviceAreaLabel}. James and a small crew do the work themselves.
      </p>
      <div class="hero-actions">
        <a class="btn btn-orange" href="/contact/">Get a Free Estimate</a>
        <a class="btn btn-ghost-light" href={`tel:${site.phoneTel}`}>Call {site.phoneDisplay}</a>
      </div>
      <ul class="trust">
        <li>Insured</li>
        <li>Warranty on the work</li>
        <li>{site.yelp.label}</li>
      </ul>
      <p class="hero-credit">{heroPhoto.caption}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="services-heading">What we do</h2>
        <p>
          Kitchens, baths, whole-home remodels, paint, flooring, siding, fences, pergolas, decks, metal roofs, windows, doors, and stonework for {site.serviceAreaLabel}.
        </p>
      </div>
      {
        serviceGroups.map((group) => (
          <div class="service-block">
            <p class="kicker">{group}</p>
            <ul class="service-grid">
              {services
                .filter((service) => service.group === group)
                .map((service) => (
                  <li>
                    <a class="service-card" href={`/services/${service.slug}/`}>
                      <h3>{service.name}</h3>
                      <p>{service.summary}</p>
                      <span>Learn more</span>
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="cta-band" aria-labelledby="mid-cta">
    <div class="wrap">
      <p class="eyebrow">Free estimate</p>
      <h2 id="mid-cta">Tell James about the project.</h2>
      <p>Call {site.phoneDisplay} or send the details. He follows up.</p>
      <div class="cta-actions">
        <a class="btn btn-orange" href="/contact/">Get a Free Estimate</a>
        <a class="btn btn-ghost-light" href={`tel:${site.phoneTel}`}>Call {site.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <section class="section cream" aria-labelledby="reviews-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="reviews-heading">What customers say</h2>
        <p>{site.yelp.label}. Quoted here the way they were written.</p>
        <SocialLinks />
      </div>
      <div class="quotes">
        {
          reviews.map((review) => (
            <figure class="quote quote-review">
              <blockquote>{review.quote}</blockquote>
              <figcaption>
                {review.name}
                <span>
                  {review.source}, {review.date}
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="stories-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="stories-heading">Before and after</h2>
        <p>The same jobs, earlier in the work and further along.</p>
      </div>
      {
        comparisons.map((story) => (
          <article class="story" id={story.id}>
            <h3>{story.title}</h3>
            <p>{story.text}</p>
            <div class="compare">
              {story.steps.flatMap((step) =>
                step.photos
                  .filter((photo, index) => index === 0)
                  .map((photo) => (
                    <figure>
                      <span class="compare-tag">{photo.stepLabel}</span>
                      <div class="frame-fill">
                        <Photo
                          src={photo.src}
                          alt={photo.alt}
                          sizes="(min-width: 720px) 45vw, 100vw"
                          widths={photo.soft ? [360, 560] : [480, 800]}
                        />
                      </div>
                      <figcaption>{photo.caption}</figcaption>
                    </figure>
                  )),
              )}
            </div>
          </article>
        ))
      }
      <p>
        <a class="btn btn-navy" href="/gallery/#comparisons">See more progress shots</a>
      </p>
    </div>
  </section>

  <section class="section cream" aria-labelledby="crew-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="crew-heading">A small crew, on the tools</h2>
        <p>James and the people who work with him. Painting, framing, roofing, and stone, on the job.</p>
      </div>
      <ul class="photo-grid">
        {
          crew.map((photo) => (
            <li class="photo-card">
              <div class="frame-fill">
                <Photo
                  src={photo.src}
                  alt={photo.alt}
                  sizes="(min-width: 980px) 340px, (min-width: 720px) 45vw, 100vw"
                  widths={[400, 720]}
                />
              </div>
              <figcaption>{photo.caption}</figcaption>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="work-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="work-heading">Recent work</h2>
        <p>Finished jobs from {site.legalName}. More photos are on the gallery page.</p>
      </div>
      <ul class="photo-grid">
        {
          highlights.map((photo) => (
            <li class="photo-card">
              <a href={`/gallery/#${photo.id}`}>
                <div class="frame-fill">
                  <Photo
                    src={photo.src}
                    alt={photo.alt}
                    sizes="(min-width: 980px) 340px, (min-width: 720px) 45vw, 100vw"
                    widths={[400, 720]}
                  />
                </div>
                <figcaption>
                  {photo.caption}
                  <span class="cat-tag">{categoryLabel(photo.category)}</span>
                </figcaption>
              </a>
            </li>
          ))
        }
      </ul>
      <p style="margin-top:1rem">
        <a class="btn btn-navy" href="/gallery/">See the gallery</a>
      </p>
    </div>
  </section>

  <section class="section cream" aria-labelledby="faq-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="faq-heading">Questions people ask</h2>
      </div>
      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="area-heading">
    <div class="wrap area-layout">
      <div>
        <p class="eyebrow">Service area</p>
        <h2 id="area-heading">DeSoto, Cedar Hill, Lancaster, and beyond</h2>
        <p>{site.displayArea}. Past jobs include work in McKinney and Garland.</p>
        <p>
          <a class="btn btn-orange" href="/contact/">Get a Free Estimate</a>
        </p>
      </div>
      <ul class="chips">
        {
          site.cities.map((city) => (
            <li class="chip">
              {city.name}
              {city.role === "past" && <small>Past work</small>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
