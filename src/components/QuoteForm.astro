---
import { formState, services, site } from "../config/site";

const form = formState();
const origin = Astro.site?.toString().replace(/\/$/, "") ?? site.siteUrl;
const ajaxAction = form.action;
const formsubmitId = site.form.formsubmitId.trim();
const plainAction = form.ready && formsubmitId
  ? `https://formsubmit.co/${formsubmitId}`
  : "#estimate";
---

<form
  id="estimate"
  class="form"
  method="POST"
  enctype="multipart/form-data"
  action={plainAction}
  data-estimate-form
  data-ready={form.ready ? "true" : "false"}
  data-ajax={ajaxAction}
  data-email={site.email}
  data-phone={site.phoneDisplay}
  novalidate
>
  <input type="hidden" name="_subject" value="Free estimate request — Jamestudio Construction" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_next" value={`${origin}/thank-you/`} />
  <p class="hp" aria-hidden="true">
    <label>Company website <input name="_honey" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="fields">
    <label class="field">
      <span>Name</span>
      <input name="name" type="text" autocomplete="name" required />
      <span class="field-error" data-error-for="name"></span>
    </label>
    <label class="field">
      <span>Phone</span>
      <input name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
      <span class="field-error" data-error-for="phone"></span>
    </label>
    <label class="field">
      <span>Email</span>
      <input name="email" type="email" autocomplete="email" required />
      <span class="field-error" data-error-for="email"></span>
    </label>
    <label class="field">
      <span>City</span>
      <input name="city" type="text" autocomplete="address-level2" list="estimate-cities" required />
      <datalist id="estimate-cities">
        {site.cities.map((city) => <option value={city.name} />)}
      </datalist>
      <span class="field-error" data-error-for="city"></span>
    </label>
  </div>

  <label class="field">
    <span>Service</span>
    <select name="service" required>
      <option value="">Select a service</option>
      {services.map((service) => <option value={service.name}>{service.name}</option>)}
    </select>
    <span class="field-error" data-error-for="service"></span>
  </label>

  <label class="field">
    <span>Message</span>
    <textarea name="message" required placeholder="What do you want done, and roughly where in the house or yard?"></textarea>
    <span class="field-error" data-error-for="message"></span>
  </label>

  <div class="field">
    <span id="files-label">Photos or files <span class="hint">(optional)</span></span>
    <input
      id="estimate-files"
      class="file-input"
      type="file"
      name="attachment"
      accept=".jpg,.jpeg,.png,.heic,.webp,.pdf,image/jpeg,image/png,image/heic,image/webp,application/pdf"
      multiple
      aria-labelledby="files-label"
    />
    <button class="btn file-btn" type="button" data-file-trigger>Add photos or files</button>
    <ul class="file-list" data-file-list></ul>
    <span class="hint">JPG, PNG, HEIC, WebP, or PDF. 5 MB total.</span>
    <span class="field-error" data-error-for="files"></span>
  </div>

  <button class="btn btn-orange" type="submit">Request my free estimate</button>
  <p class="form-status" data-form-status role="status"></p>
  <div class="form-success" data-form-success hidden tabindex="-1">
    <h2>Request sent</h2>
    <p>
      Thanks. James will follow up about the project. If it is urgent, call
      <a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
      or email <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-estimate-form]");
  const status = form?.querySelector<HTMLElement>("[data-form-status]");
  const success = form?.querySelector<HTMLElement>("[data-form-success]");
  if (form && status && success) {
    const fields = ["name", "phone", "email", "city", "service", "message", "files"] as const;
    const maxBytes = 5 * 1024 * 1024;
    const allowed = new Set(["jpg", "jpeg", "png", "heic", "webp", "pdf"]);
    const fileInput = form.querySelector<HTMLInputElement>("#estimate-files");
    const fileList = form.querySelector<HTMLUListElement>("[data-file-list]");
    const fileTrigger = form.querySelector<HTMLButtonElement>("[data-file-trigger]");
    let chosen: File[] = [];

    function extension(file: File) {
      const parts = file.name.split(".");
      return parts.length > 1 ? (parts.pop() ?? "").toLowerCase() : "";
    }

    function formatSize(bytes: number) {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${Math.max(1, Math.round(bytes / 1024))} KB`;
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    }

    function renderFiles() {
      if (!fileList) return;
      fileList.replaceChildren();
      for (const [index, file] of chosen.entries()) {
        const item = document.createElement("li");
        const text = document.createElement("p");
        const name = document.createElement("span");
        name.textContent = file.name;
        const size = document.createElement("span");
        size.className = "hint";
        size.textContent = formatSize(file.size);
        text.append(name, size);
        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "file-remove";
        remove.textContent = "Remove";
        remove.setAttribute("aria-label", `Remove ${file.name}`);
        remove.addEventListener("click", () => {
          chosen.splice(index, 1);
          renderFiles();
          setError("files", "");
        });
        item.append(text, remove);
        fileList.append(item);
      }
    }

    function addFiles(files: File[]) {
      const next = [...chosen];
      let error = "";
      for (const file of files) {
        if (!allowed.has(extension(file))) {
          error = `${file.name} needs to be a JPG, PNG, HEIC, WebP, or PDF.`;
          continue;
        }
        const total = next.reduce((sum, item) => sum + item.size, 0) + file.size;
        if (file.size > maxBytes || total > maxBytes) {
          error = "Those files are over 5 MB total. Remove one or send smaller photos.";
          continue;
        }
        next.push(file);
      }
      chosen = next;
      setError("files", error);
      renderFiles();
    }

    fileTrigger?.addEventListener("click", () => fileInput?.click());
    fileInput?.addEventListener("change", () => {
      addFiles([...(fileInput.files ?? [])]);
      fileInput.value = "";
    });

    function control(name: string) {
      return form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
        `[name="${name}"]`,
      );
    }

    function setError(name: string, message: string) {
      const input = name === "files" ? fileInput : control(name);
      const slot = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (slot) slot.textContent = message;
      if (input) {
        input.setAttribute("aria-invalid", message ? "true" : "false");
        if (message && slot) {
          if (!slot.id) slot.id = `error-${name}`;
          input.setAttribute("aria-describedby", slot.id);
        } else {
          input.removeAttribute("aria-describedby");
        }
      }
    }

    function validate() {
      const name = control("name")?.value.trim() ?? "";
      const phone = control("phone")?.value.trim() ?? "";
      const email = control("email")?.value.trim() ?? "";
      const city = control("city")?.value.trim() ?? "";
      const service = control("service")?.value.trim() ?? "";
      const message = control("message")?.value.trim() ?? "";
      const digits = phone.replace(/\D/g, "");
      const problems: { name: (typeof fields)[number]; message: string }[] = [];
      if (name.length < 2) problems.push({ name: "name", message: "Enter your name." });
      if (digits.length < 10) problems.push({ name: "phone", message: "Enter a phone number with area code." });
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        problems.push({ name: "email", message: "Enter a valid email address." });
      }
      if (city.length < 2) problems.push({ name: "city", message: "Enter your city." });
      if (!service) problems.push({ name: "service", message: "Choose a service." });
      if (message.length < 10) {
        problems.push({ name: "message", message: "Tell James a little about the project." });
      }
      for (const field of fields) setError(field, "");
      for (const problem of problems) setError(problem.name, problem.message);
      return { problems, values: { name, phone, email, city, service, message } };
    }

    form.addEventListener("submit", async (event) => {
      if (form.dataset.ready !== "true") return;
      event.preventDefault();
      const honey = form.querySelector<HTMLInputElement>('[name="_honey"]')?.value ?? "";
      const { problems } = validate();
      if (problems.length > 0) {
        status.textContent = "Check the highlighted fields, then send it again.";
        control(problems[0].name)?.focus();
        return;
      }
      if (honey.trim()) {
        form.classList.add("is-sent");
        success.hidden = false;
        success.focus();
        return;
      }

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      status.textContent = "Sending…";
      if (fileInput) {
        const transfer = new DataTransfer();
        for (const file of chosen) transfer.items.add(file);
        fileInput.files = transfer.files;
      }
      form.submit();
    });
  }
</script>
