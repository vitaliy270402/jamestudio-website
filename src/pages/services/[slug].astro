---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Photo from "../../components/Photo.astro";
import { photosForService } from "../../data/gallery";
import { relatedServices, services, site, type Service } from "../../config/site";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const related = relatedServices(service.slug);
const gallery = photosForService(service.slug);
const title = `${service.seoName} in ${site.titlePlace} | ${site.legalName}`;
const description = service.meta;
---

<BaseLayout title={title} description={description}>
  <header class="page-hero">
    <div class="wrap">
      <ol class="crumbs">
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/services/">Services</a></li>
        <li aria-hidden="true">/</li>
        <li>{service.name}</li>
      </ol>
      <h1>{service.seoName} in {site.titlePlace}</h1>
      <p>{service.summary} Serving {site.serviceAreaLabel}.</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap" style="display:grid;gap:2rem">
      <div class="prose">
        {service.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {
          service.includes && (
            <ul class="includes">
              {service.includes.map((item) => <li>{item}</li>)}
            </ul>
          )
        }
        <p>
          <a class="btn btn-orange" href="/contact/">Get a Free Estimate</a>
        </p>
        <p>
          <a href={`tel:${site.phoneTel}`}>Call {site.phoneDisplay}</a>
        </p>
      </div>

      <div>
        <h2>Photos</h2>
        {
          gallery.length > 0 ? (
            <ul class="photo-grid" style="margin-top:0.8rem">
              {gallery.map((photo) => (
                <li class="photo-card">
                  <div class="frame-fill">
                    <Photo
                      src={photo.src}
                      alt={photo.alt}
                      sizes="(min-width: 980px) 340px, (min-width: 720px) 45vw, 100vw"
                      widths={photo.soft ? [320, 480] : [400, 720]}
                    />
                  </div>
                  <figcaption>{photo.caption}</figcaption>
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty-photos">
              Photos for {service.name.toLowerCase()} will be added as those projects are photographed.
            </p>
          )
        }
      </div>

      <div>
        <h2>Related services</h2>
        <ul class="related" style="margin-top:0.8rem">
          {related.map((item) => <li><a href={`/services/${item.slug}/`}>{item.name}</a></li>)}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
