---
import { site } from "../config/site";

const onContact = Astro.url.pathname === "/contact/";
---

<div class="callbar">
  <a class="btn btn-orange" href={`tel:${site.phoneTel}`}>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
      <path
        d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 7a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1L6.6 10.8Z"
      ></path>
    </svg>
    {site.phoneDisplay}
  </a>
  <a class="btn btn-ghost-light" href={onContact ? "#estimate" : "/contact/"}>Free estimate</a>
</div>
