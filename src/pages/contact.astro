---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteForm from "../components/QuoteForm.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { site } from "../config/site";

const title = `Get a Free Estimate | ${site.legalName}`;
const description = `Request a free estimate from ${site.legalName} in ${site.serviceAreaLabel}. Call ${site.phoneDisplay} or send your name, city, and the service you need.`;
---

<BaseLayout title={title} description={description}>
  <header class="page-hero">
    <div class="wrap">
      <ol class="crumbs">
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li>Free estimate</li>
      </ol>
      <h1>Get a free estimate</h1>
      <p>Call, email, or send the project details. James will follow up.</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap contact-grid">
      <div>
        <p>Tell James what you want done and the city. You can attach photos or a PDF with the request.</p>
        <QuoteForm />
      </div>
      <aside class="contact-aside">
        <h2>Talk to James</h2>
        <p><a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p>{site.displayArea}</p>
        <p>{site.yelp.label}</p>
        <SocialLinks />
        <p>Insured, with a warranty on the work.</p>
      </aside>
    </div>
  </section>
</BaseLayout>
