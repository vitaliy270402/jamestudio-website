---
import { Image } from "astro:assets";
import logo from "../assets/brand/logo-drive.jpg";
import { serviceGroups, services, site } from "../config/site";

---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href="/" aria-label="Jamestudio Construction, home">
      <Image
        src={logo}
        alt="JAMESTUDIO CONSTRUCTION"
        width={320}
        densities={[1, 2]}
        loading="eager"
      />
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <a href="/gallery/">Gallery</a>
      <details class="services-drop">
        <summary>Services</summary>
        <div class="services-panel">
          {
            serviceGroups.map((group) => (
              <div>
                <h2>{group}</h2>
                <ul>
                  {services
                    .filter((service) => service.group === group)
                    .map((service) => (
                      <li>
                        <a href={`/services/${service.slug}/`}>{service.name}</a>
                      </li>
                    ))}
                </ul>
              </div>
            ))
          }
          <a href="/services/">All services</a>
        </div>
      </details>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
    </nav>

    <a class="header-call" href={`tel:${site.phoneTel}`}>
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
        <path
          d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 7a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1L6.6 10.8Z"
        ></path>
      </svg>
      <span>Call {site.phoneDisplay}</span>
    </a>
    <a class="btn btn-orange header-estimate" href="/contact/">Get a Free Estimate</a>

    <details class="menu">
      <summary aria-label="Open menu">Menu</summary>
      <div class="menu-panel">
        <a href="/">Home</a>
        <a href="/gallery/">Gallery</a>
        <a href="/about/">About</a>
        <a href="/contact/">Get a Free Estimate</a>
        {
          serviceGroups.map((group) => (
            <div class="menu-group">
              <h2>{group}</h2>
              <ul>
                {services
                  .filter((service) => service.group === group)
                  .map((service) => (
                    <li>
                      <a href={`/services/${service.slug}/`}>{service.name}</a>
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>
    </details>
  </div>
</header>
