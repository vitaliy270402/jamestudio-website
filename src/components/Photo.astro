---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  priority?: boolean;
  quality?: number;
  class?: string;
}

const { src, alt, sizes, priority = false, quality = 74, class: className } = Astro.props;
const requested = (Astro.props.widths ?? [480, 720, 960]).filter((width) => width <= src.width);
const widths = requested.length > 0 ? requested : [src.width];
const displayWidth = widths[widths.length - 1] ?? src.width;

const shared = {
  src,
  widths,
  width: displayWidth,
  layout: "constrained" as const,
  quality,
};

const avif = await getImage({ ...shared, format: "avif" });
const webp = await getImage({ ...shared, format: "webp" });
const width = webp.attributes.width ?? displayWidth;
const height = webp.attributes.height ?? Math.round((src.height / src.width) * displayWidth);
---

<picture>
  {
    avif.srcSet.attribute && (
      <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
    )
  }
  {
    webp.srcSet.attribute && (
      <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
    )
  }
  <img
    src={webp.src}
    alt={alt}
    width={width}
    height={height}
    sizes={sizes}
    loading={priority ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={priority ? "high" : "auto"}
    class={className}
  />
</picture>
