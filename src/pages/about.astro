---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Photo from "../components/Photo.astro";
import SocialLinks from "../components/SocialLinks.astro";
import logo from "../assets/brand/logo-drive.jpg";
import { crewPhotos } from "../data/gallery";
import { reviews, services, site } from "../config/site";

const title = `About ${site.legalName} | ${site.titlePlace}`;
const description = `${site.legalName} is a small remodeling crew for ${site.serviceAreaLabel}. Insured, with a warranty. ${site.yelp.label}.`;
const crew = crewPhotos().slice(0, 4);
---

<BaseLayout title={title} description={description}>
  <header class="page-hero">
    <div class="wrap">
      <ol class="crumbs">
        <li><a href="/">Home</a></li>
        <li aria-hidden="true">/</li>
        <li>About</li>
      </ol>
      <h1>About {site.legalName}</h1>
      <p>A small, hands-on crew for {site.serviceAreaLabel}.</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap prose">
      <Image class="about-logo" src={logo} alt="JAMESTUDIO CONSTRUCTION" width={360} densities={[1, 2]} />
      <p>
        {site.legalName} remodels and renovates homes in {site.serviceAreaLabel}. James Koban runs the work with a small crew. Customers come back to the same things: the quality of the work, showing up on time, following through, and paying attention to the details.
      </p>
      <p>{site.taglines[1]} {site.taglines[2]}</p>
      <p>{site.yelp.label}</p>
      <SocialLinks />
      <h2>On the job</h2>
      <ul class="photo-grid">
        {
          crew.map((photo) => (
            <li class="photo-card">
              <div class="frame-fill">
                <Photo src={photo.src} alt={photo.alt} sizes="(min-width: 720px) 45vw, 100vw" widths={[400, 720]} />
              </div>
              <figcaption>{photo.caption}</figcaption>
            </li>
          ))
        }
      </ul>
      <h2>From Yelp</h2>
      <div class="quotes">
        {
          reviews.map((review) => (
            <figure class="quote quote-review">
              <blockquote>{review.quote}</blockquote>
              <figcaption>
                {review.name}
                <span>
                  {review.source}, {review.date}
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <h2>Services</h2>
      <ul>
        {services.map((service) => <li><a href={`/services/${service.slug}/`}>{service.name}</a></li>)}
      </ul>
      <p>
        <a class="btn btn-orange" href="/contact/">Get a Free Estimate</a>
      </p>
    </div>
  </section>
</BaseLayout>
